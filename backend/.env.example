# Elasticsearch
ELASTIC_URL=http://localhost:9200
ELASTIC_USER=
ELASTIC_PASS=
ELASTIC_INDEX=netflow-*
# ELASTIC_API_KEY=  # opcional, use no lugar de USER/PASS

# TLS (Elastic com certificado self-signed, ex. https://172.20.20.250:9200)
# 0/false = aceita self-signed (padrão p/ lab); 1/true = verifica o cert
ELASTIC_TLS_REJECT_UNAUTHORIZED=0
# Alternativas mais seguras (recomendado em produção):
# ELASTIC_CA_FINGERPRINT=AB:CD:EF:...
# ELASTIC_CA_FILE=C:\certs\http_ca.crt

# Backend
PORT=3001
# Limite de buckets do mapa por consulta. 0 desliga o limite (não recomendado).
MAX_EDGES=50000
# Limite menor para consultas detalhadas com porta de origem (host/dossiê/comparador).
MAX_SPORT_BUCKETS=10000
# Portas de serviço extras (além de <=1023) p/ rótulos e listas:
# KNOWN_SERVICE_PORTS=1433,1521,3306,3389,5432,5601,5666,5900,5985,6379,8080,8443,9200,9300,10050,10051,1514,2055,27017
COMPOSITE_PAGE_SIZE=1000

# Mapa de conexões (/api/graph). A janela inteira é agregada por par no ES,
# mas o navegador só recebe as N arestas de maior volume. A mesma agregação
# (e o mesmo cache) serve Pares, Dashboard → Tráfego e /api/alerts.
# MAP_DEFAULT_EDGES=3000          # arestas enviadas quando o front não pede limite
# MAP_MAX_EDGES_RESPONSE=30000    # teto absoluto por resposta ("Todas" no front)
# MAP_MAX_PAIRS=200000            # teto de pares (src,dst) lidos do ES por janela
# MAP_PAGE_SIZE=2000              # pares por página do composite
# MAP_CACHE_TTL_MS=20000          # cache da agregação (janela relativa); absoluta fica 15x
# HOST_MAX_PAIRS=40000            # pares lidos no detalhe de um host (~2 por peer)
# Fila global para não sobrecarregar o ES com dashboards/rotas simultâneos.
ELASTIC_MAX_CONCURRENT_SEARCHES=3
ELASTIC_MAX_QUEUED_SEARCHES=24
ELASTIC_SEARCH_QUEUE_TIMEOUT_MS=15000
ELASTIC_MAX_RETRIES=1
# ELASTIC_REQUEST_TIMEOUT_MS=120000
ELASTIC_SLOW_SEARCH_WARN_MS=30000
# Início/fim do fluxo. Neste ambiente são DATE (ISO 8601); outro exporter pode
# mandar epoch. O código detecta os dois, mas o override existe para o caso raro
# de campo com outro nome.
# ELASTIC_FIELD_FLOWSTART=netflow.flowStartMilliseconds
# ELASTIC_FIELD_FLOWEND=netflow.flowEndMilliseconds

# Nomes (rDNS + inventário estático; vCenter entra aqui no futuro)
RDNS_ENABLED=1
RDNS_TIMEOUT_MS=1500
RDNS_CACHE_TTL_MS=3600000
# DNS recursivo p/ PTR externo (se o DNS interno não resolve a internet):
# RDNS_DNS_SERVERS=8.8.8.8,1.1.1.1
# ASN/organização de IPs públicos via Team Cymru (sem API key)
ASN_ENABLED=1
ASN_CACHE_TTL_MS=86400000
# INVENTORY_FILE=./inventario.json  # JSON: { "172.20.20.28": "web-01" }
ACTIVE_WINDOW_SEC=120 # "ativa" = pacote nos últimos N segundos (detalhe do host)

# Top talkers (/api/alerts)
ALERT_TOP_N=10

# Reputação de IPs públicos — somente AbuseIPDB (verde = score 0, vermelho = score > 0)
# ABUSEIPDB_KEY=...   # chave grátis em abuseipdb.com
REP_CACHE_TTL_MS=21600000
REP_TIMEOUT_MS=8000
REP_PG_TTL_DAYS=7      # cache de reputação no Postgres (não queima a cota a cada restart)

# Postgres — histórico, reputação e sub-redes.
# Opcional: sem ele as features que dependem de histórico caem, o resto roda.
# DATABASE_URL=postgresql://teia:senha@172.20.20.250:5432/teiadearanha
PGHOST=172.20.20.250
PGPORT=5432
PGUSER=teia
PGPASSWORD=            # se tiver # ou espaços, use aspas: "minha#senha"
PGDATABASE=teiadearanha

# Fuso do agendador de colheita de regiões
CRON_TZ=America/Sao_Paulo

# A feature "Vigilância de hosts" foi removida: WATCH_CRON, WATCH_TZ,
# WATCH_LOOKBACK_HOURS, WATCH_SILENCE_DAYS e WATCH_TOP_PORTS não são mais lidos.

# Histórico de regiões (colheita diária acumulativa, nunca apaga)
REGIONS_CRON=15 6 * * *    # colhe últimas 24h todo dia (0 = desliga)

# Fuso dos dias locais no histórico de IPs. Linhas antigas em dia UTC NÃO são
# migradas automaticamente.
REPORT_TZ=America/Fortaleza

# Chave AES-256-GCM que cifra o token da API do FortiGate no Postgres.
# 64 hex = 32 bytes; gere outra com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# FortiGate usa HTTPS com cert self-signed (ignorado como curl -k).
# FORTIGATE_KEY=a60f...64hex
# FORTIGATE_TIMEOUT_MS=8000
# A porta HTTPS de cada FortiGate é informada no cadastro (padrão 443).
# FORTIGATE_PORT só vale como padrão para firewalls sem porta cadastrada.
# FORTIGATE_PORT=443
